<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>CBT Sekolah</title>
<link rel="manifest" id="pwaManifest">
<meta name="theme-color" content="#1e40af">
<style>
:root{
  --teal:#00C2CB; --magenta:#FF00FF; --yellow:#FFC700; --black:#000000; --white:#FFFFFF; --beige:#F5F3DC;
  --bg:var(--beige); --card:var(--white); --text:#000000; --muted:#555048; --border:#000000;
  --danger:#FF3B3B; --success:#00B86B; --warn:var(--yellow);
  --radius:0px; --radius-sm:4px;
  --shadow-1:4px 4px 0 var(--black); --shadow-2:8px 8px 0 var(--black);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Arial Black','Helvetica Neue',Arial,sans-serif;background:var(--bg);color:var(--text);
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);}
html,body{height:100%;}
button{font-family:inherit;cursor:pointer;border:none;}
input,select,textarea{font-family:inherit;}
.app{display:flex;min-height:100vh;}
.sidebar{width:230px;background:var(--black);color:#fff;display:flex;flex-direction:column;padding:20px 0;flex-shrink:0;border-right:4px solid var(--black);}
.sidebar h2{padding:0 20px 20px;font-size:20px;border-bottom:3px solid var(--yellow);margin-bottom:10px;text-transform:uppercase;letter-spacing:.5px;}
.nav-item{padding:14px 20px;cursor:pointer;opacity:.9;font-size:13px;font-weight:800;text-transform:uppercase;display:flex;align-items:center;gap:10px;border-left:4px solid transparent;}
.nav-item.active{background:var(--teal);color:#000;opacity:1;border-left:4px solid var(--black);}
.nav-item:hover{opacity:1;background:rgba(255,255,255,.1);}
.main{flex:1;padding:28px;overflow-y:auto;max-width:100%;}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px;flex-wrap:wrap;gap:10px;}
.topbar h1{font-size:28px;text-transform:uppercase;font-weight:900;letter-spacing:.5px;}
.btn{background:var(--teal);color:#000;padding:11px 20px;font-size:13px;font-weight:900;text-transform:uppercase;letter-spacing:.3px;
  border:3px solid var(--black);box-shadow:var(--shadow-1);transition:transform .08s,box-shadow .08s;}
.btn:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--black);}
.btn:active{transform:translate(4px,4px);box-shadow:0 0 0 var(--black);}
.btn.danger{background:var(--magenta);color:#fff;}
.btn.success{background:var(--success);color:#fff;}
.btn.ghost{background:var(--white);color:#000;}
.btn.small{padding:7px 14px;font-size:11px;box-shadow:3px 3px 0 var(--black);}
.btn.small:hover{transform:translate(1px,1px);box-shadow:2px 2px 0 var(--black);}
.card{background:var(--card);border:3px solid var(--black);box-shadow:var(--shadow-2);padding:22px;margin-bottom:20px;}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;}
table{width:100%;border-collapse:collapse;font-size:13px;}
th,td{padding:10px;text-align:left;border-bottom:2px solid var(--black);}
th{color:#000;font-weight:900;background:var(--yellow);text-transform:uppercase;font-size:11px;letter-spacing:.3px;}
.badge{padding:4px 12px;border:2px solid var(--black);font-size:11px;font-weight:900;text-transform:uppercase;display:inline-block;}
.badge.green{background:var(--success);color:#fff;}
.badge.yellow{background:var(--yellow);color:#000;}
.badge.red{background:var(--magenta);color:#fff;animation:pulse 1.2s infinite;}
.badge.gray{background:var(--beige);color:#000;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.card h3{font-size:16px;text-transform:uppercase;font-weight:900;letter-spacing:.3px;border-bottom:3px solid var(--yellow);display:inline-block;padding-bottom:4px;}
.form-row{margin-bottom:16px;}
.form-row label{display:block;font-size:12px;font-weight:900;margin-bottom:6px;color:#000;text-transform:uppercase;letter-spacing:.3px;}
.form-row input,.form-row select,.form-row textarea{width:100%;padding:11px 12px;border:3px solid var(--black);font-size:14px;background:#fff;}
.form-row input:focus,.form-row select:focus,.form-row textarea:focus{outline:3px solid var(--teal);outline-offset:1px;}
.hidden{display:none !important;}
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--black);padding:20px;
  background-image:linear-gradient(var(--teal) 2px, transparent 2px),linear-gradient(90deg, var(--teal) 2px, transparent 2px);
  background-size:40px 40px; background-color:#0a0a0a;}
.login-card{background:var(--white);border:4px solid var(--black);box-shadow:var(--shadow-2);padding:38px 32px;max-width:380px;width:100%;}
.login-card h1{text-align:center;color:#000;margin-bottom:6px;font-size:28px;text-transform:uppercase;font-weight:900;}
.login-card p.sub{text-align:center;color:var(--muted);font-size:13px;margin-bottom:24px;font-weight:700;}
.role-tabs{display:flex;gap:8px;margin-bottom:22px;}
.role-tabs button{flex:1;padding:11px;background:var(--white);color:#000;font-weight:900;font-size:12px;border:3px solid var(--black);text-transform:uppercase;}
.role-tabs button.active{background:var(--yellow);box-shadow:3px 3px 0 var(--black);}
.error-msg{background:var(--magenta);color:#fff;padding:10px;border:2px solid var(--black);font-size:13px;font-weight:800;margin-bottom:14px;}
.preview-banner{background:var(--yellow);color:#000;text-align:center;padding:9px;font-size:12px;font-weight:900;border-bottom:3px solid var(--black);text-transform:uppercase;}
/* Exam taking */
.exam-screen{min-height:100vh;background:var(--beige);display:flex;flex-direction:column;}
.exam-header{background:var(--black);color:#fff;padding:16px 20px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10;border-bottom:4px solid var(--yellow);}
.timer{font-size:22px;font-weight:900;background:var(--yellow);color:#000;padding:7px 18px;border:3px solid var(--black);}
.exam-body{flex:1;padding:22px;max-width:700px;margin:0 auto;width:100%;}
.soal-nav{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;}
.soal-nav button{width:38px;height:38px;background:#fff;border:3px solid var(--black);font-weight:900;font-size:12px;}
.soal-nav button.answered{background:var(--teal);}
.soal-nav button.current{background:var(--magenta);color:#fff;}
.opsi-item{display:flex;align-items:center;gap:10px;padding:13px;border:3px solid var(--black);margin-bottom:10px;cursor:pointer;background:#fff;font-weight:700;}
.opsi-item:hover{background:#fffde7;}
.opsi-item.selected{background:var(--teal);box-shadow:var(--shadow-1);}
.match-row{display:flex;gap:10px;align-items:center;margin-bottom:10px;}
.lock-overlay{position:fixed;inset:0;background:var(--black);color:#fff;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px;}
.lock-overlay h2{font-size:26px;margin-bottom:12px;color:var(--yellow);text-transform:uppercase;font-weight:900;border:3px solid var(--yellow);padding:10px 20px;}
.warn-toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:var(--magenta);color:#fff;padding:14px 24px;border:3px solid var(--black);z-index:9998;font-weight:900;box-shadow:var(--shadow-2);text-transform:uppercase;font-size:13px;}
@media(max-width:768px){
  .sidebar{position:fixed;bottom:0;left:0;right:0;width:100%;flex-direction:row;justify-content:space-around;padding:8px 0;z-index:100;top:auto;height:auto;border-right:none;border-top:4px solid var(--yellow);}
  .sidebar h2{display:none;}
  .nav-item{flex-direction:column;font-size:9px;padding:8px 4px;flex:1;text-align:center;gap:2px;border-left:none;}
  .nav-item.active{border-left:none;border-top:4px solid var(--teal);}
  .main{padding-bottom:90px;}
}
</style>
</head>
<body>
<div id="appRoot"></div>
<div id="toastRoot"></div>
<script type="module">
// ====================== KONFIGURASI APLIKASI ======================
const IS_PREVIEW = true; // UBAH KE false SAAT DEPLOY KE GOOGLE APPS SCRIPT

// ====================== PWA SETUP (Manifest + Service Worker) ======================
const manifest = {
  name: "CBT Sekolah", short_name: "CBT", start_url: ".", display: "standalone",
  background_color: "#f1f5f9", theme_color: "#1e40af",
  icons: [{src:"data:image/svg+xml;base64,"+btoa('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="20" fill="%231e40af"/><text x="50" y="62" font-size="40" fill="white" text-anchor="middle" font-family="Arial">CBT</text></svg>'), sizes:"100x100", type:"image/svg+xml"}]
};
document.getElementById('pwaManifest').href = "data:application/manifest+json," + encodeURIComponent(JSON.stringify(manifest));
if ('serviceWorker' in navigator) {
  const swCode = `self.addEventListener('install',e=>self.skipWaiting());self.addEventListener('activate',e=>self.clients.claim());self.addEventListener('fetch',e=>{});`;
  const swBlob = new Blob([swCode], {type:'application/javascript'});
  navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(()=>{});
}

// ====================== DATA API (Preview vs Produksi) ======================
function uid(prefix){ return prefix + '_' + Math.random().toString(36).slice(2,9); }
function nowISO(){ return new Date().toISOString(); }

let PREVIEW_DB = {
  admin: [{username:'admin', password:'admin2026'}],
  guru: [{id_guru:'g1', nama:'Budi Santoso', mapel:'Matematika', username:'budi', password:'guru123', status_aktif:true}],
  siswa: [
    {id_siswa:'s1', nama:'Ani Lestari', nisn:'1001', kelas:'9A'},
    {id_siswa:'s2', nama:'Rudi Hartono', nisn:'1002', kelas:'9A'}
  ],
  bankSoal: [
    {id_soal:'q1', id_guru:'g1', mapel:'Matematika', tipe_soal:'pg', pertanyaan:'Berapakah hasil dari 12 x 8?',
      data_soal:{opsi:[{k:'a',v:'86'},{k:'b',v:'96'},{k:'c',v:'106'},{k:'d',v:'88'}]}, kunci_jawaban:{benar:'b'}, bobot:10},
    {id_soal:'q2', id_guru:'g1', mapel:'Matematika', tipe_soal:'benar_salah', pertanyaan:'Bilangan prima terkecil adalah 2.',
      data_soal:{}, kunci_jawaban:{benar:true}, bobot:10},
    {id_soal:'q3', id_guru:'g1', mapel:'Matematika', tipe_soal:'pg_kompleks', pertanyaan:'Manakah bilangan genap di bawah ini? (pilih 2)',
      data_soal:{opsi:[{k:'a',v:'3'},{k:'b',v:'4'},{k:'c',v:'7'},{k:'d',v:'8'}]}, kunci_jawaban:{benar:['b','d']}, bobot:10},
    {id_soal:'q4', id_guru:'g1', mapel:'Matematika', tipe_soal:'menjodohkan', pertanyaan:'Jodohkan bangun datar dengan jumlah sisinya',
      data_soal:{kiri:[{k:'1',v:'Segitiga'},{k:'2',v:'Persegi'}], kanan:[{k:'a',v:'4 sisi'},{k:'b',v:'3 sisi'}]},
      kunci_jawaban:{pasangan:{'1':'b','2':'a'}}, bobot:10}
  ],
  ujian: [{id_ujian:'u1', id_guru:'g1', nama_ujian:'Ulangan Harian Matematika', mapel:'Matematika', kelas:'9A',
    tanggal:'2026-11-20', durasi_menit:30, daftar_id_soal:['q1','q2','q3','q4'], status:'aktif', batas_pelanggaran:3}],
  token: [{token_code:'MTK001', id_ujian:'u1', status_dipakai:false, waktu_generate:nowISO(), waktu_expired:null}],
  hasilUjian: []
};

function callServer(fnName, ...args){
  if (IS_PREVIEW) return Promise.resolve(PreviewAPI[fnName](...args));
  return new Promise((resolve, reject) => {
    google.script.run.withSuccessHandler(resolve).withFailureHandler(reject)[fnName](...args);
  });
}

const PreviewAPI = {
  loginAdmin(u,p){ const a = PREVIEW_DB.admin.find(x=>x.username===u && x.password===p); return a? {success:true, data:{username:a.username}} : {success:false, message:'Username atau password salah'}; },
  loginGuru(u,p){ const g = PREVIEW_DB.guru.find(x=>x.username===u && x.password===p); if(!g) return {success:false, message:'Username atau password salah'}; if(!g.status_aktif) return {success:false, message:'Akun dinonaktifkan oleh admin'}; return {success:true, data:g}; },
  loginSiswaToken(token, nama, nisn){
    const t = PREVIEW_DB.token.find(x=>x.token_code===token);
    if(!t) return {success:false, message:'Token tidak ditemukan'};
    if(t.status_dipakai) return {success:false, message:'Token sudah digunakan'};
    const ujian = PREVIEW_DB.ujian.find(x=>x.id_ujian===t.id_ujian);
    if(!ujian) return {success:false, message:'Ujian tidak ditemukan'};
    const siswa = PREVIEW_DB.siswa.find(x=>x.nisn===nisn) || {id_siswa:uid('s'), nama, nisn, kelas:ujian.kelas};
    t.status_dipakai = true;
    const soalList = ujian.daftar_id_soal.map(id=>{ const s = PREVIEW_DB.bankSoal.find(b=>b.id_soal===id); return {id_soal:s.id_soal, tipe_soal:s.tipe_soal, pertanyaan:s.pertanyaan, data_soal:s.data_soal, bobot:s.bobot}; });
    const id_hasil = uid('h');
    PREVIEW_DB.hasilUjian.push({id_hasil, id_ujian:ujian.id_ujian, id_siswa:siswa.id_siswa, nama_siswa:siswa.nama, token_dipakai:token,
      jawaban_json:{}, nilai:null, waktu_mulai:nowISO(), waktu_selesai:null, status:'dikerjakan', jumlah_pelanggaran:0, log_pelanggaran:[]});
    return {success:true, data:{id_hasil, ujian, soalList}};
  },
  getGuruList(){ return PREVIEW_DB.guru; },
  addGuru(obj){ obj.id_guru = uid('g'); obj.status_aktif = true; PREVIEW_DB.guru.push(obj); return {success:true}; },
  resetPasswordGuru(id_guru, newPassword){ const g = PREVIEW_DB.guru.find(x=>x.id_guru===id_guru); if(g) g.password = newPassword; return {success:true}; },
  toggleGuruStatus(id_guru){ const g = PREVIEW_DB.guru.find(x=>x.id_guru===id_guru); if(g) g.status_aktif = !g.status_aktif; return {success:true}; },
  getSiswaList(){ return PREVIEW_DB.siswa; },
  addSiswaBulk(list){ list.forEach(s=>{ s.id_siswa = uid('s'); PREVIEW_DB.siswa.push(s); }); return {success:true}; },
  getSoalList(id_guru){ return PREVIEW_DB.bankSoal.filter(x=>x.id_guru===id_guru); },
  saveSoal(obj){ if(obj.id_soal){ const i = PREVIEW_DB.bankSoal.findIndex(x=>x.id_soal===obj.id_soal); PREVIEW_DB.bankSoal[i] = obj; } else { obj.id_soal = uid('q'); PREVIEW_DB.bankSoal.push(obj); } return {success:true, id_soal:obj.id_soal}; },
  importSoalBulk(list){ list.forEach(obj=>{ obj.id_soal = uid('q'); PREVIEW_DB.bankSoal.push(obj); }); return {success:true, jumlah:list.length}; },
  deleteSoal(id_soal){ PREVIEW_DB.bankSoal = PREVIEW_DB.bankSoal.filter(x=>x.id_soal!==id_soal); return {success:true}; },
  getUjianList(id_guru){ return PREVIEW_DB.ujian.filter(x=>x.id_guru===id_guru); },
  getAllUjianList(){ return PREVIEW_DB.ujian; },
  saveUjian(obj){ if(obj.id_ujian){ const i = PREVIEW_DB.ujian.findIndex(x=>x.id_ujian===obj.id_ujian); PREVIEW_DB.ujian[i] = obj; } else { obj.id_ujian = uid('u'); obj.status='aktif'; PREVIEW_DB.ujian.push(obj); } return {success:true, id_ujian:obj.id_ujian}; },
  generateToken(id_ujian, jumlah){ const tokens=[]; for(let i=0;i<jumlah;i++){ const code = Math.random().toString(36).slice(2,8).toUpperCase(); PREVIEW_DB.token.push({token_code:code, id_ujian, status_dipakai:false, waktu_generate:nowISO(), waktu_expired:null}); tokens.push(code);} return {success:true, tokens}; },
  getTokenList(id_ujian){ return PREVIEW_DB.token.filter(x=>x.id_ujian===id_ujian); },
  reportViolation(id_hasil){
    const h = PREVIEW_DB.hasilUjian.find(x=>x.id_hasil===id_hasil);
    if(!h) return {success:false};
    h.jumlah_pelanggaran++;
    h.log_pelanggaran.push({waktu:nowISO()});
    const ujian = PREVIEW_DB.ujian.find(x=>x.id_ujian===h.id_ujian);
    let locked = false;
    if(h.jumlah_pelanggaran >= ujian.batas_pelanggaran && h.status==='dikerjakan'){ h.status = 'terkunci_menunggu_persetujuan'; locked = true; }
    return {success:true, locked, jumlah_pelanggaran:h.jumlah_pelanggaran};
  },
  getHasilStatus(id_hasil){ const h = PREVIEW_DB.hasilUjian.find(x=>x.id_hasil===id_hasil); return h? {status:h.status, jumlah_pelanggaran:h.jumlah_pelanggaran} : {status:'tidak_ditemukan'}; },
  getMonitoring(id_ujian){ return PREVIEW_DB.hasilUjian.filter(x=>x.id_ujian===id_ujian).map(h=>({id_hasil:h.id_hasil, nama_siswa:h.nama_siswa, status:h.status, jumlah_pelanggaran:h.jumlah_pelanggaran})); },
  approveSiswa(id_hasil){ const h = PREVIEW_DB.hasilUjian.find(x=>x.id_hasil===id_hasil); if(h){ h.status='dikerjakan'; h.riwayat_keputusan = h.riwayat_keputusan||[]; h.riwayat_keputusan.push({aksi:'izinkan_lanjut', waktu:nowISO()}); } return {success:true}; },
  forceSubmitSiswa(id_hasil){ return PreviewAPI.submitJawaban(id_hasil, null, true); },
  submitJawaban(id_hasil, jawabanJson, dipaksaGuru){
    const h = PREVIEW_DB.hasilUjian.find(x=>x.id_hasil===id_hasil);
    if(!h) return {success:false};
    if(jawabanJson) h.jawaban_json = jawabanJson;
    const ujian = PREVIEW_DB.ujian.find(x=>x.id_ujian===h.id_ujian);
    let total=0, maks=0;
    ujian.daftar_id_soal.forEach(idSoal=>{
      const soal = PREVIEW_DB.bankSoal.find(x=>x.id_soal===idSoal);
      maks += soal.bobot;
      const jwb = h.jawaban_json[idSoal];
      if(jwb===undefined) return;
      if(soal.tipe_soal==='pg' || soal.tipe_soal==='benar_salah'){ if(jwb === soal.kunci_jawaban.benar) total += soal.bobot; }
      else if(soal.tipe_soal==='pg_kompleks'){
        const benar = soal.kunci_jawaban.benar.slice().sort().join(',');
        const jawab = (jwb||[]).slice().sort().join(',');
        if(benar===jawab) total += soal.bobot;
      } else if(soal.tipe_soal==='menjodohkan'){
        const pasangan = soal.kunci_jawaban.pasangan; let semuaBenar = true;
        Object.keys(pasangan).forEach(k=>{ if(!jwb || jwb[k]!==pasangan[k]) semuaBenar=false; });
        if(semuaBenar) total += soal.bobot;
      }
    });
    h.nilai = maks>0 ? Math.round((total/maks)*100) : 0;
    h.status = 'selesai';
    h.waktu_selesai = nowISO();
    return {success:true, nilai:h.nilai};
  },
  getHasilUjian(id_ujian){ return PREVIEW_DB.hasilUjian.filter(x=>x.id_ujian===id_ujian); },
  publishHasil(id_ujian){ PREVIEW_DB.hasilUjian.filter(x=>x.id_ujian===id_ujian).forEach(h=> h.dipublikasikan = true); return {success:true}; },
  getHasilSiswa(id_hasil){ const h = PREVIEW_DB.hasilUjian.find(x=>x.id_hasil===id_hasil); return h? {nilai:h.nilai, dipublikasikan: !!h.dipublikasikan, status:h.status} : null; }
};

// ====================== STATE & ROUTER ======================
let STATE = { role:null, user:null, view:'dashboard', examData:null, examAnswers:{}, examTimer:null, examSecondsLeft:0, lockPollTimer:null, cheatCount:0 };
const root = document.getElementById('appRoot');
const toastRoot = document.getElementById('toastRoot');

function toast(msg, type){
  const el = document.createElement('div');
  el.className = 'warn-toast';
  if(type==='success') el.style.background = 'var(--success)';
  el.textContent = msg;
  toastRoot.appendChild(el);
  setTimeout(()=> el.remove(), 3500);
}

function render(){
  if(!STATE.role){ renderLogin(); return; }
  if(STATE.role==='siswa' && STATE.examData){ renderExam(); return; }
  if(STATE.role==='admin') renderAdmin();
  else if(STATE.role==='guru') renderGuru();
}

// ---------- LOGIN ----------
let loginTab = 'guru';
function renderLogin(){
  root.innerHTML = `
  <div class="login-wrap">
    <div class="login-card">
      ${IS_PREVIEW ? '<div class="preview-banner" style="margin:-36px -30px 20px;border-radius:18px 18px 0 0;">MODE PREVIEW — Admin: admin/admin2026 | Guru: budi/guru123 | Token Siswa: MTK001</div>':''}
      <h1>CBT Sekolah</h1>
      <p class="sub">Ujian Berbasis Komputer</p>
      <div class="role-tabs">
        <button id="tabGuru" class="${loginTab==='guru'?'active':''}">Guru/Admin</button>
        <button id="tabSiswa" class="${loginTab==='siswa'?'active':''}">Siswa</button>
      </div>
      <div id="errBox"></div>
      <div id="loginFormWrap"></div>
    </div>
  </div>`;
  document.getElementById('tabGuru').onclick = ()=>{ loginTab='guru'; renderLogin(); };
  document.getElementById('tabSiswa').onclick = ()=>{ loginTab='siswa'; renderLogin(); };
  const wrap = document.getElementById('loginFormWrap');
  if(loginTab==='guru'){
    wrap.innerHTML = `
      <div class="form-row"><label>Username</label><input id="lu" placeholder="Username Admin / Guru"></div>
      <div class="form-row"><label>Password</label><input id="lp" type="password" placeholder="Password"></div>
      <button class="btn" style="width:100%" id="btnLoginGuru">Masuk</button>`;
    document.getElementById('btnLoginGuru').onclick = async ()=>{
      const u = document.getElementById('lu').value.trim(), p = document.getElementById('lp').value;
      let res = await callServer('loginAdmin', u, p);
      if(res.success){ STATE.role='admin'; STATE.user=res.data; render(); return; }
      res = await callServer('loginGuru', u, p);
      if(res.success){ STATE.role='guru'; STATE.user=res.data; render(); return; }
      document.getElementById('errBox').innerHTML = `<div class="error-msg">${res.message||'Login gagal'}</div>`;
    };
  } else {
    wrap.innerHTML = `
      <div class="form-row"><label>Nomor Token Ujian</label><input id="ltoken" placeholder="Masukkan token dari guru" style="text-transform:uppercase"></div>
      <div class="form-row"><label>Nama Lengkap</label><input id="lnama" placeholder="Nama sesuai absen"></div>
      <div class="form-row"><label>NISN</label><input id="lnisn" placeholder="NISN"></div>
      <button class="btn" style="width:100%" id="btnLoginSiswa">Mulai Ujian</button>`;
    document.getElementById('btnLoginSiswa').onclick = async ()=>{
      const token = document.getElementById('ltoken').value.trim().toUpperCase();
      const nama = document.getElementById('lnama').value.trim();
      const nisn = document.getElementById('lnisn').value.trim();
      if(!token || !nama || !nisn){ document.getElementById('errBox').innerHTML = `<div class="error-msg">Semua kolom wajib diisi</div>`; return; }
      const res = await callServer('loginSiswaToken', token, nama, nisn);
      if(!res.success){ document.getElementById('errBox').innerHTML = `<div class="error-msg">${res.message}</div>`; return; }
      STATE.role='siswa'; STATE.user={nama, nisn};
      startExamSession(res.data);
    };
  }
}

function logout(){
  if(STATE.examTimer) clearInterval(STATE.examTimer);
  if(STATE.lockPollTimer) clearInterval(STATE.lockPollTimer);
  STATE = { role:null, user:null, view:'dashboard', examData:null, examAnswers:{}, examTimer:null, examSecondsLeft:0, lockPollTimer:null, cheatCount:0 };
  if(document.fullscreenElement) document.exitFullscreen().catch(()=>{});
  render();
}

// ---------- LAYOUT SHELL ----------
function shell(navItems, title, contentHtml){
  root.innerHTML = `
  <div class="app">
    <div class="sidebar">
      <h2>CBT Sekolah</h2>
      ${navItems.map(n=>`<div class="nav-item ${STATE.view===n.key?'active':''}" data-nav="${n.key}">${n.label}</div>`).join('')}
      <div class="nav-item" id="btnLogout">Keluar</div>
    </div>
    <div class="main">
      <div class="topbar"><h1>${title}</h1><span style="color:var(--muted);font-size:13px">${STATE.user.nama||STATE.user.username}</span></div>
      <div id="content">${contentHtml}</div>
    </div>
  </div>`;
  navItems.forEach(n=>{ document.querySelector(`[data-nav="${n.key}"]`).onclick = ()=>{ STATE.view = n.key; render(); }; });
  document.getElementById('btnLogout').onclick = logout;
}

// ---------- ADMIN ----------
async function renderAdmin(){
  const nav = [{key:'dashboard',label:'Dashboard'},{key:'guru',label:'Kelola Guru'},{key:'siswa',label:'Kelola Siswa'},{key:'ujian',label:'Semua Ujian'},{key:'rekap',label:'Rekap Nilai'}];
  let html = '';
  if(STATE.view==='dashboard'){
    const guruList = await callServer('getGuruList');
    const siswaList = await callServer('getSiswaList');
    const ujianList = await callServer('getAllUjianList');
    html = `<div class="grid">
      <div class="card"><div style="color:var(--muted);font-size:13px">Total Guru</div><div style="font-size:28px;font-weight:800">${guruList.length}</div></div>
      <div class="card"><div style="color:var(--muted);font-size:13px">Total Siswa</div><div style="font-size:28px;font-weight:800">${siswaList.length}</div></div>
      <div class="card"><div style="color:var(--muted);font-size:13px">Total Ujian</div><div style="font-size:28px;font-weight:800">${ujianList.length}</div></div>
    </div>`;
  } else if(STATE.view==='guru'){
    html = await renderKelolaGuru();
  } else if(STATE.view==='siswa'){
    html = await renderKelolaSiswa();
  } else if(STATE.view==='ujian'){
    const list = await callServer('getAllUjianList');
    html = `<div class="card"><table><thead><tr><th>Ujian</th><th>Mapel</th><th>Kelas</th><th>Tanggal</th><th>Status</th></tr></thead><tbody>
      ${list.map(u=>`<tr><td>${u.nama_ujian}</td><td>${u.mapel}</td><td>${u.kelas}</td><td>${u.tanggal}</td><td><span class="badge green">${u.status}</span></td></tr>`).join('') || '<tr><td colspan="5">Belum ada ujian</td></tr>'}
    </tbody></table></div>`;
  } else if(STATE.view==='rekap'){
    const ujianList = await callServer('getAllUjianList');
    let rows = '';
    for(const u of ujianList){
      const hasil = await callServer('getHasilUjian', u.id_ujian);
      rows += hasil.map(h=>`<tr><td>${u.nama_ujian}</td><td>${h.nama_siswa}</td><td>${h.nilai ?? '-'}</td><td>${h.status}</td></tr>`).join('');
    }
    html = `<div class="card"><table><thead><tr><th>Ujian</th><th>Siswa</th><th>Nilai</th><th>Status</th></tr></thead><tbody>${rows || '<tr><td colspan="4">Belum ada hasil</td></tr>'}</tbody></table></div>`;
  }
  shell(nav, nav.find(n=>n.key===STATE.view).label, html);
  if(STATE.view==='guru') bindKelolaGuru();
  if(STATE.view==='siswa') bindKelolaSiswa();
}

async function renderKelolaGuru(){
  const list = await callServer('getGuruList');
  window.__guruList = list;
  return `
  <div class="card">
    <h3 style="margin-bottom:14px">Tambah Guru Baru</h3>
    <div class="grid">
      <div class="form-row"><label>Nama</label><input id="ng_nama"></div>
      <div class="form-row"><label>Mapel</label><input id="ng_mapel"></div>
      <div class="form-row"><label>Username</label><input id="ng_username"></div>
      <div class="form-row"><label>Password</label><input id="ng_password"></div>
    </div>
    <button class="btn" id="btnAddGuru">Tambah Guru</button>
  </div>
  <div class="card"><table><thead><tr><th>Nama</th><th>Mapel</th><th>Username</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
    ${list.map(g=>`<tr><td>${g.nama}</td><td>${g.mapel}</td><td>${g.username}</td><td><span class="badge ${g.status_aktif?'green':'red'}">${g.status_aktif?'Aktif':'Nonaktif'}</span></td>
      <td><button class="btn small ghost" data-reset="${g.id_guru}">Reset Password</button> <button class="btn small danger" data-toggle="${g.id_guru}">${g.status_aktif?'Nonaktifkan':'Aktifkan'}</button></td></tr>`).join('')}
  </tbody></table></div>`;
}
function bindKelolaGuru(){
  document.getElementById('btnAddGuru').onclick = async ()=>{
    const obj = { nama:ng_nama.value, mapel:ng_mapel.value, username:ng_username.value, password:ng_password.value };
    if(!obj.nama||!obj.username||!obj.password){ toast('Lengkapi semua kolom'); return; }
    await callServer('addGuru', obj); toast('Guru ditambahkan','success'); renderAdmin();
  };
  document.querySelectorAll('[data-reset]').forEach(b=> b.onclick = async ()=>{
    const np = prompt('Masukkan password baru untuk guru ini:');
    if(np){ await callServer('resetPasswordGuru', b.dataset.reset, np); toast('Password berhasil direset','success'); }
  });
  document.querySelectorAll('[data-toggle]').forEach(b=> b.onclick = async ()=>{ await callServer('toggleGuruStatus', b.dataset.toggle); renderAdmin(); });
}

async function renderKelolaSiswa(){
  const list = await callServer('getSiswaList');
  return `
  <div class="card">
    <h3 style="margin-bottom:14px">Tambah Siswa</h3>
    <div class="grid">
      <div class="form-row"><label>Nama</label><input id="ns_nama"></div>
      <div class="form-row"><label>NISN</label><input id="ns_nisn"></div>
      <div class="form-row"><label>Kelas</label><input id="ns_kelas" placeholder="contoh: 9A"></div>
    </div>
    <button class="btn" id="btnAddSiswa">Tambah Siswa</button>
  </div>
  <div class="card"><table><thead><tr><th>Nama</th><th>NISN</th><th>Kelas</th></tr></thead><tbody>
    ${list.map(s=>`<tr><td>${s.nama}</td><td>${s.nisn}</td><td>${s.kelas}</td></tr>`).join('')}
  </tbody></table></div>`;
}
function bindKelolaSiswa(){
  document.getElementById('btnAddSiswa').onclick = async ()=>{
    const obj = { nama:ns_nama.value, nisn:ns_nisn.value, kelas:ns_kelas.value };
    if(!obj.nama||!obj.nisn||!obj.kelas){ toast('Lengkapi semua kolom'); return; }
    await callServer('addSiswaBulk', [obj]); toast('Siswa ditambahkan','success'); renderAdmin();
  };
}

// ---------- GURU ----------
async function renderGuru(){
  const nav = [{key:'dashboard',label:'Dashboard'},{key:'soal',label:'Bank Soal'},{key:'ujian',label:'Buat Ujian'},{key:'token',label:'Token & Peserta'},{key:'monitoring',label:'Monitoring Live'},{key:'hasil',label:'Hasil Ujian'}];
  let html='';
  if(STATE.view==='dashboard'){
    const soal = await callServer('getSoalList', STATE.user.id_guru);
