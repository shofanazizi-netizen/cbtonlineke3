  if(STATE.view==='monitoring') bindMonitoring();
  if(STATE.view==='hasil') bindHasilUjian();
}

// --- Bank Soal ---
let soalFormType = 'pg';
async function renderBankSoal(){
  const list = await callServer('getSoalList', STATE.user.id_guru);
  window.__soalList = list;
  return `
  <div class="card">
    <h3 style="margin-bottom:14px">Tambah Soal</h3>
    <div class="form-row"><label>Tipe Soal</label>
      <select id="sq_tipe">
        <option value="pg">Pilihan Ganda</option>
        <option value="menjodohkan">Menjodohkan</option>
        <option value="pg_kompleks">Pilihan Ganda Kompleks (2 jawaban benar)</option>
        <option value="benar_salah">Benar/Salah</option>
      </select>
    </div>
    <div class="form-row"><label>Pertanyaan</label><textarea id="sq_pertanyaan" rows="2"></textarea></div>
    <div id="sq_dynamic"></div>
    <div class="form-row" style="max-width:150px"><label>Bobot Nilai</label><input id="sq_bobot" type="number" value="10"></div>
    <button class="btn" id="btnSimpanSoal">Simpan Soal</button>
  </div>
  <div class="card">
    <h3 style="margin-bottom:10px">Impor Soal dari CSV</h3>
    <p style="font-size:12px;color:var(--muted);margin-bottom:14px;font-weight:700">Format kolom: tipe_soal,pertanyaan,data1,data2,data3,data4,kunci,bobot. Untuk PG/PG Kompleks: data1-4=opsi A-D, kunci="a" atau "a|c". Benar/Salah: kosongkan data1-4, kunci="benar"/"salah". Menjodohkan: data1=kiri dipisah "|", data2=kanan dipisah "|" (urutan sama=berpasangan), kunci dikosongkan.</p>
    <button class="btn ghost small" id="btnDownloadTemplate" style="margin-bottom:14px">Unduh Template CSV</button>
    <div class="form-row"><label>Pilih File CSV</label><input type="file" id="sq_importfile" accept=".csv"></div>
    <button class="btn" id="btnImportSoal">Impor Soal</button>
    <div id="importResultBox" style="margin-top:10px;font-size:13px;font-weight:700"></div>
  </div>
  <div class="card"><table><thead><tr><th>Tipe</th><th>Pertanyaan</th><th>Bobot</th><th>Aksi</th></tr></thead><tbody>
    ${list.map(s=>`<tr><td><span class="badge gray">${labelTipe(s.tipe_soal)}</span></td><td>${s.pertanyaan}</td><td>${s.bobot}</td><td><button class="btn small danger" data-delsoal="${s.id_soal}">Hapus</button></td></tr>`).join('') || '<tr><td colspan="4">Belum ada soal</td></tr>'}
  </tbody></table></div>`;
}

function parseCSVLine(line){
  // Parser CSV sederhana yang mendukung tanda kutip ganda
  const result = []; let cur=''; let inQuotes=false;
  for(let i=0;i<line.length;i++){
    const ch = line[i];
    if(ch==='"'){ inQuotes = !inQuotes; }
    else if(ch===',' && !inQuotes){ result.push(cur); cur=''; }
    else { cur += ch; }
  }
  result.push(cur);
  return result.map(x=>x.trim());
}

function buildSoalFromCSVRow(cols, id_guru, mapel){
  const [tipe_soal, pertanyaan, d1, d2, d3, d4, kunci, bobotStr] = cols;
  const bobot = parseInt(bobotStr) || 10;
  let data_soal = {}, kunci_jawaban = {};
  if(tipe_soal==='pg'){
    data_soal = { opsi:[{k:'a',v:d1},{k:'b',v:d2},{k:'c',v:d3},{k:'d',v:d4}] };
    kunci_jawaban = { benar: kunci.trim() };
  } else if(tipe_soal==='pg_kompleks'){
    data_soal = { opsi:[{k:'a',v:d1},{k:'b',v:d2},{k:'c',v:d3},{k:'d',v:d4}] };
    kunci_jawaban = { benar: kunci.split('|').map(x=>x.trim()) };
  } else if(tipe_soal==='benar_salah'){
    kunci_jawaban = { benar: kunci.trim().toLowerCase()==='benar' };
  } else if(tipe_soal==='menjodohkan'){
    const kiriArr = d1.split('|').map(x=>x.trim()).filter(Boolean);
    const kananArr = d2.split('|').map(x=>x.trim()).filter(Boolean);
    const kiri = kiriArr.map((v,i)=>({k:String(i+1), v}));
    const kanan = kananArr.map((v,i)=>({k:String.fromCharCode(97+i), v}));
    const pasangan = {}; kiri.forEach((k,i)=> pasangan[k.k] = kanan[i] ? kanan[i].k : '');
    data_soal = { kiri, kanan };
    kunci_jawaban = { pasangan };
  } else {
    return null;
  }
  return { id_guru, mapel, tipe_soal, pertanyaan, data_soal, kunci_jawaban, bobot };
}

function downloadTextFile(filename, content, mime){
  const blob = new Blob([content], {type: mime || 'text/plain;charset=utf-8;'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
function labelTipe(t){ return {pg:'Pilihan Ganda', menjodohkan:'Menjodohkan', pg_kompleks:'PG Kompleks', benar_salah:'Benar/Salah'}[t]||t; }

function renderSoalDynamicForm(tipe){
  const el = document.getElementById('sq_dynamic');
  if(tipe==='pg'){
    el.innerHTML = `
      <div class="form-row"><label>Opsi A</label><input id="sq_a"></div>
      <div class="form-row"><label>Opsi B</label><input id="sq_b"></div>
      <div class="form-row"><label>Opsi C</label><input id="sq_c"></div>
      <div class="form-row"><label>Opsi D</label><input id="sq_d"></div>
      <div class="form-row"><label>Jawaban Benar</label><select id="sq_kunci"><option value="a">A</option><option value="b">B</option><option value="c">C</option><option value="d">D</option></select></div>`;
  } else if(tipe==='pg_kompleks'){
    el.innerHTML = `
      <div class="form-row"><label>Opsi A</label><input id="sq_a"></div>
      <div class="form-row"><label>Opsi B</label><input id="sq_b"></div>
      <div class="form-row"><label>Opsi C</label><input id="sq_c"></div>
      <div class="form-row"><label>Opsi D</label><input id="sq_d"></div>
      <div class="form-row"><label>2 Jawaban Benar (pisah koma, contoh: a,c)</label><input id="sq_kunci" placeholder="a,c"></div>`;
  } else if(tipe==='benar_salah'){
    el.innerHTML = `<div class="form-row"><label>Jawaban Benar</label><select id="sq_kunci"><option value="true">Benar</option><option value="false">Salah</option></select></div>`;
  } else if(tipe==='menjodohkan'){
    el.innerHTML = `
      <p style="font-size:12px;color:var(--muted);margin-bottom:8px">Isi daftar kiri & kanan dipisah baris baru, dengan urutan yang sama berarti berpasangan</p>
      <div class="grid">
        <div class="form-row"><label>Kolom Kiri (soal)</label><textarea id="sq_kiri" rows="4" placeholder="Segitiga&#10;Persegi"></textarea></div>
        <div class="form-row"><label>Kolom Kanan (jawaban - akan diacak saat tampil)</label><textarea id="sq_kanan" rows="4" placeholder="3 sisi&#10;4 sisi"></textarea></div>
      </div>`;
  }
}
function bindBankSoal(){
  renderSoalDynamicForm(soalFormType);
  document.getElementById('sq_tipe').value = soalFormType;
  document.getElementById('sq_tipe').onchange = (e)=>{ soalFormType = e.target.value; renderSoalDynamicForm(soalFormType); };
  document.getElementById('btnSimpanSoal').onclick = async ()=>{
    const tipe = document.getElementById('sq_tipe').value;
    const pertanyaan = document.getElementById('sq_pertanyaan').value.trim();
    const bobot = parseInt(document.getElementById('sq_bobot').value)||10;
    if(!pertanyaan){ toast('Pertanyaan wajib diisi'); return; }
    let data_soal={}, kunci_jawaban={};
    if(tipe==='pg'){
      data_soal = { opsi:[{k:'a',v:sq_a.value},{k:'b',v:sq_b.value},{k:'c',v:sq_c.value},{k:'d',v:sq_d.value}] };
      kunci_jawaban = { benar: sq_kunci.value };
    } else if(tipe==='pg_kompleks'){
      data_soal = { opsi:[{k:'a',v:sq_a.value},{k:'b',v:sq_b.value},{k:'c',v:sq_c.value},{k:'d',v:sq_d.value}] };
      kunci_jawaban = { benar: sq_kunci.value.split(',').map(x=>x.trim()) };
    } else if(tipe==='benar_salah'){
      kunci_jawaban = { benar: sq_kunci.value === 'true' };
    } else if(tipe==='menjodohkan'){
      const kiriArr = sq_kiri.value.split('\n').filter(Boolean);
      const kananArr = sq_kanan.value.split('\n').filter(Boolean);
      const kiri = kiriArr.map((v,i)=>({k:String(i+1), v}));
      const kanan = kananArr.map((v,i)=>({k:String.fromCharCode(97+i), v}));
      const pasangan = {}; kiri.forEach((k,i)=> pasangan[k.k] = kanan[i].k);
      data_soal = { kiri, kanan };
      kunci_jawaban = { pasangan };
    }
    await callServer('saveSoal', { id_guru:STATE.user.id_guru, mapel:STATE.user.mapel, tipe_soal:tipe, pertanyaan, data_soal, kunci_jawaban, bobot });
    toast('Soal tersimpan','success'); renderGuru();
  };
  document.querySelectorAll('[data-delsoal]').forEach(b=> b.onclick = async ()=>{ await callServer('deleteSoal', b.dataset.delsoal); renderGuru(); });

  document.getElementById('btnDownloadTemplate').onclick = ()=>{
    const template = 'tipe_soal,pertanyaan,data1,data2,data3,data4,kunci,bobot\n' +
      'pg,Berapakah hasil dari 5 + 3?,6,7,8,9,c,10\n' +
      'pg_kompleks,Manakah bilangan genap? (pilih 2),3,4,7,8,b|d,10\n' +
      'benar_salah,Matahari terbit dari timur,,,,,,benar,10\n' +
      'menjodohkan,Jodohkan ibu kota dengan negaranya,Indonesia|Jepang,Jakarta|Tokyo,,,,10\n';
    downloadTextFile('template_impor_soal.csv', template, 'text/csv;charset=utf-8;');
  };
  document.getElementById('btnImportSoal').onclick = ()=>{
    const fileInput = document.getElementById('sq_importfile');
    const resultBox = document.getElementById('importResultBox');
    if(!fileInput.files || !fileInput.files[0]){ toast('Pilih file CSV terlebih dahulu'); return; }
    const reader = new FileReader();
    reader.onload = async (e)=>{
      const text = e.target.result;
      const lines = text.split(/\r?\n/).filter(l=>l.trim()!=='');
      lines.shift(); // buang baris header
      const soalArray = [];
      let gagal = 0;
      lines.forEach(line=>{
        const cols = parseCSVLine(line);
        if(cols.length < 8){ gagal++; return; }
        const soal = buildSoalFromCSVRow(cols, STATE.user.id_guru, STATE.user.mapel);
        if(soal) soalArray.push(soal); else gagal++;
      });
      if(soalArray.length===0){ resultBox.innerHTML = '<span style="color:var(--danger)">Tidak ada soal valid ditemukan di file.</span>'; return; }
      await callServer('importSoalBulk', soalArray);
      resultBox.innerHTML = `<span style="color:var(--success)">${soalArray.length} soal berhasil diimpor.${gagal>0 ? ' ('+gagal+' baris dilewati karena format salah)' : ''}</span>`;
      toast(`${soalArray.length} soal berhasil diimpor`,'success');
      setTimeout(()=>renderGuru(), 1200);
    };
    reader.readAsText(fileInput.files[0]);
  };
}

// --- Buat Ujian ---
async function renderBuatUjian(){
  const soalList = await callServer('getSoalList', STATE.user.id_guru);
  return `
  <div class="card">
    <h3 style="margin-bottom:14px">Buat Ujian Baru</h3>
    <div class="grid">
      <div class="form-row"><label>Nama Ujian</label><input id="uj_nama"></div>
      <div class="form-row"><label>Kelas</label><input id="uj_kelas" placeholder="contoh: 9A"></div>
      <div class="form-row"><label>Tanggal</label><input id="uj_tanggal" type="date"></div>
      <div class="form-row"><label>Durasi (menit)</label><input id="uj_durasi" type="number" value="60"></div>
      <div class="form-row"><label>Batas Pelanggaran (sebelum dikunci)</label><input id="uj_batas" type="number" value="3"></div>
    </div>
    <div class="form-row"><label>Pilih Soal</label>
      <div style="max-height:200px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:10px">
      ${soalList.map(s=>`<label style="display:flex;gap:8px;align-items:center;padding:4px 0"><input type="checkbox" class="chk-soal" value="${s.id_soal}"> ${s.pertanyaan} <span class="badge gray">${labelTipe(s.tipe_soal)}</span></label>`).join('') || 'Belum ada soal di Bank Soal'}
      </div>
    </div>
    <button class="btn" id="btnBuatUjian">Simpan Ujian</button>
  </div>
  <div class="card"><h3 style="margin-bottom:14px">Daftar Ujian Saya</h3>
  <table><thead><tr><th>Nama</th><th>Kelas</th><th>Tanggal</th><th>Durasi</th><th>Jml Soal</th></tr></thead><tbody id="ujianListBody"><tr><td colspan="5">Memuat...</td></tr></tbody></table></div>`;
}
async function bindBuatUjian(){
  const list = await callServer('getUjianList', STATE.user.id_guru);
  document.getElementById('ujianListBody').innerHTML = list.map(u=>`<tr><td>${u.nama_ujian}</td><td>${u.kelas}</td><td>${u.tanggal}</td><td>${u.durasi_menit} mnt</td><td>${u.daftar_id_soal.length}</td></tr>`).join('') || '<tr><td colspan="5">Belum ada ujian</td></tr>';
  document.getElementById('btnBuatUjian').onclick = async ()=>{
    const ids = Array.from(document.querySelectorAll('.chk-soal:checked')).map(c=>c.value);
    if(!uj_nama.value || !uj_kelas.value || !uj_tanggal.value || ids.length===0){ toast('Lengkapi data & pilih minimal 1 soal'); return; }
    await callServer('saveUjian', { id_guru:STATE.user.id_guru, nama_ujian:uj_nama.value, mapel:STATE.user.mapel, kelas:uj_kelas.value,
      tanggal:uj_tanggal.value, durasi_menit:parseInt(uj_durasi.value), daftar_id_soal:ids, batas_pelanggaran:parseInt(uj_batas.value)||3 });
    toast('Ujian berhasil dibuat','success'); renderGuru();
  };
}

// --- Token & Peserta ---
let tokenSelectedUjian = null;
async function renderTokenPeserta(){
  const ujianList = await callServer('getUjianList', STATE.user.id_guru);
  tokenSelectedUjian = tokenSelectedUjian || (ujianList[0] && ujianList[0].id_ujian);
  let tokenListHtml = '<tr><td colspan="3">Pilih ujian dahulu</td></tr>';
  if(tokenSelectedUjian){
    const tokens = await callServer('getTokenList', tokenSelectedUjian);
    tokenListHtml = tokens.map(t=>`<tr><td style="font-family:monospace;font-weight:700">${t.token_code}</td><td><span class="badge ${t.status_dipakai?'gray':'green'}">${t.status_dipakai?'Terpakai':'Belum dipakai'}</span></td><td>${new Date(t.waktu_generate).toLocaleString('id-ID')}</td></tr>`).join('') || '<tr><td colspan="3">Belum ada token</td></tr>';
  }
  return `
  <div class="card">
    <div class="form-row"><label>Pilih Ujian</label>
      <select id="tk_ujian">${ujianList.map(u=>`<option value="${u.id_ujian}" ${u.id_ujian===tokenSelectedUjian?'selected':''}>${u.nama_ujian} - ${u.kelas}</option>`).join('')}</select>
    </div>
    <div class="form-row" style="max-width:150px"><label>Jumlah Token</label><input id="tk_jumlah" type="number" value="5"></div>
    <button class="btn" id="btnGenToken">Generate Token</button>
  </div>
  <div class="card"><table><thead><tr><th>Token</th><th>Status</th><th>Waktu Dibuat</th></tr></thead><tbody id="tokenListBody">${tokenListHtml}</tbody></table></div>`;
}
function bindTokenPeserta(){
  document.getElementById('tk_ujian').onchange = (e)=>{ tokenSelectedUjian = e.target.value; renderGuru(); };
  document.getElementById('btnGenToken').onclick = async ()=>{
    const jumlah = parseInt(document.getElementById('tk_jumlah').value)||1;
    await callServer('generateToken', tokenSelectedUjian, jumlah);
    toast('Token berhasil dibuat','success'); renderGuru();
  };
}

// --- Monitoring Live ---
let monitorSelectedUjian = null, monitorPoll = null;
async function renderMonitoring(){
  const ujianList = await callServer('getUjianList', STATE.user.id_guru);
  monitorSelectedUjian = monitorSelectedUjian || (ujianList[0] && ujianList[0].id_ujian);
  return `
  <div class="card">
    <div class="form-row"><label>Pilih Ujian</label>
      <select id="mo_ujian">${ujianList.map(u=>`<option value="${u.id_ujian}" ${u.id_ujian===monitorSelectedUjian?'selected':''}>${u.nama_ujian} - ${u.kelas}</option>`).join('')}</select>
    </div>
  </div>
  <div class="card"><table><thead><tr><th>Siswa</th><th>Status</th><th>Pelanggaran</th><th>Aksi</th></tr></thead><tbody id="monitorBody"><tr><td colspan="4">Memuat...</td></tr></tbody></table></div>`;
}
async function refreshMonitor(){
  if(!monitorSelectedUjian) return;
  const data = await callServer('getMonitoring', monitorSelectedUjian);
  const body = document.getElementById('monitorBody');
  if(!body) return;
  body.innerHTML = data.map(h=>{
    let badge = 'green';
    if(h.jumlah_pelanggaran>=3 || h.status==='terkunci_menunggu_persetujuan') badge='red';
    else if(h.jumlah_pelanggaran>=1) badge='yellow';
    if(h.status==='selesai') badge='gray';
    let statusLabel = h.status==='dikerjakan'?'Mengerjakan': h.status==='selesai'?'Selesai': h.status==='terkunci_menunggu_persetujuan'?'MENUNGGU PERSETUJUAN':h.status;
    let aksi = '-';
    if(h.status==='terkunci_menunggu_persetujuan'){
      aksi = `<button class="btn small success" data-approve="${h.id_hasil}">Izinkan Lanjut</button> <button class="btn small danger" data-forcesubmit="${h.id_hasil}">Paksa Submit</button>`;
    }
    return `<tr><td>${h.nama_siswa}</td><td><span class="badge ${badge}">${statusLabel}</span></td><td>${h.jumlah_pelanggaran}</td><td>${aksi}</td></tr>`;
  }).join('') || '<tr><td colspan="4">Belum ada peserta mengerjakan</td></tr>';
  document.querySelectorAll('[data-approve]').forEach(b=> b.onclick = async ()=>{ await callServer('approveSiswa', b.dataset.approve); toast('Siswa diizinkan melanjutkan','success'); refreshMonitor(); });
  document.querySelectorAll('[data-forcesubmit]').forEach(b=> b.onclick = async ()=>{ if(confirm('Paksa submit jawaban siswa ini sekarang?')){ await callServer('forceSubmitSiswa', b.dataset.forcesubmit); toast('Ujian siswa dipaksa submit','success'); refreshMonitor(); } });
}
function bindMonitoring(){
  document.getElementById('mo_ujian').onchange = (e)=>{ monitorSelectedUjian = e.target.value; refreshMonitor(); };
  refreshMonitor();
  if(monitorPoll) clearInterval(monitorPoll);
  monitorPoll = setInterval(refreshMonitor, 4000);
}

// --- Hasil Ujian ---
let hasilSelectedUjian = null;
async function renderHasilUjian(){
  const ujianList = await callServer('getUjianList', STATE.user.id_guru);
  hasilSelectedUjian = hasilSelectedUjian || (ujianList[0] && ujianList[0].id_ujian);
  let rows = '<tr><td colspan="4">Pilih ujian</td></tr>';
  if(hasilSelectedUjian){
    const hasil = await callServer('getHasilUjian', hasilSelectedUjian);
    rows = hasil.map(h=>`<tr><td>${h.nama_siswa}</td><td>${h.nilai ?? '-'}</td><td>${h.status}</td><td>${h.jumlah_pelanggaran}</td></tr>`).join('') || '<tr><td colspan="4">Belum ada yang mengerjakan</td></tr>';
  }
  return `
  <div class="card">
    <div class="form-row"><label>Pilih Ujian</label>
      <select id="hs_ujian">${ujianList.map(u=>`<option value="${u.id_ujian}" ${u.id_ujian===hasilSelectedUjian?'selected':''}>${u.nama_ujian} - ${u.kelas}</option>`).join('')}</select>
    </div>
    <button class="btn" id="btnPublish">Publikasikan Nilai ke Siswa</button>
    <button class="btn ghost" id="btnExportCSV">Ekspor Rekap Nilai (CSV)</button>
  </div>
  <div class="card"><table><thead><tr><th>Siswa</th><th>Nilai</th><th>Status</th><th>Pelanggaran</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}
function bindHasilUjian(){
  document.getElementById('hs_ujian').onchange = (e)=>{ hasilSelectedUjian = e.target.value; renderGuru(); };
  document.getElementById('btnPublish').onclick = async ()=>{ await callServer('publishHasil', hasilSelectedUjian); toast('Nilai dipublikasikan ke siswa','success'); };
  document.getElementById('btnExportCSV').onclick = async ()=>{
    const hasil = await callServer('getHasilUjian', hasilSelectedUjian);
    const selectEl = document.getElementById('hs_ujian');
    const namaUjian = selectEl.options[selectEl.selectedIndex].text;
    if(!hasil || hasil.length===0){ toast('Belum ada data nilai untuk diekspor'); return; }
    let csv = 'Nama Siswa,Nilai,Status,Jumlah Pelanggaran,Waktu Mulai,Waktu Selesai\n';
    hasil.forEach(h=>{
      const row = [h.nama_siswa, h.nilai ?? '-', h.status, h.jumlah_pelanggaran, h.waktu_mulai||'', h.waktu_selesai||'']
        .map(v=> `"${String(v).replace(/"/g,'""')}"`).join(',');
      csv += row + '\n';
    });
    downloadTextFile(`rekap_nilai_${namaUjian.replace(/[^a-z0-9]/gi,'_')}.csv`, csv, 'text/csv;charset=utf-8;');
    toast('Rekap nilai berhasil diekspor','success');
  };
}

// ====================== HALAMAN UJIAN SISWA ======================
function startExamSession(data){
  STATE.examData = data; // {id_hasil, ujian, soalList}
  STATE.examAnswers = {};
  STATE.examSecondsLeft = data.ujian.durasi_menit * 60;
  STATE.currentSoalIndex = 0;
  STATE.cheatCount = 0;
  STATE.examLocked = false;
  render();
  setTimeout(enterFullscreenAndMonitor, 300);
}

function enterFullscreenAndMonitor(){
  const el = document.documentElement;
  if(el.requestFullscreen) el.requestFullscreen().catch(()=>{});
  document.addEventListener('visibilitychange', onVisibilityChange);
  document.addEventListener('fullscreenchange', onFullscreenChange);
  document.addEventListener('contextmenu', blockContext);
  document.addEventListener('keydown', blockDevKeys);
  startExamTimer();
}
function stopExamMonitoring(){
  document.removeEventListener('visibilitychange', onVisibilityChange);
  document.removeEventListener('fullscreenchange', onFullscreenChange);
  document.removeEventListener('contextmenu', blockContext);
  document.removeEventListener('keydown', blockDevKeys);
}
function blockContext(e){ if(STATE.role==='siswa' && STATE.examData) e.preventDefault(); }
function blockDevKeys(e){
  if(!STATE.examData) return;
  if(e.key==='F12' || (e.ctrlKey && e.shiftKey && ['I','J','C'].includes(e.key)) || (e.ctrlKey && e.key==='u')){
    e.preventDefault(); handleViolation();
  }
}
function onVisibilityChange(){ if(document.hidden && STATE.examData && !STATE.examLocked) handleViolation(); }
function onFullscreenChange(){ if(!document.fullscreenElement && STATE.examData && !STATE.examLocked) handleViolation(); }

async function handleViolation(){
  if(!STATE.examData || STATE.examLocked) return;
  STATE.cheatCount++;
  const res = await callServer('reportViolation', STATE.examData.id_hasil);
  if(res.locked){
    STATE.examLocked = true;
    clearInterval(STATE.examTimer);
    renderExam();
    startLockPolling();
  } else {
    toast(`Peringatan! Anda terdeteksi mencoba keluar dari ujian (${res.jumlah_pelanggaran}x). Pelanggaran dicatat pengawas.`);
    if(STATE.role==='siswa') setTimeout(()=>{ const el=document.documentElement; if(el.requestFullscreen && !document.fullscreenElement) el.requestFullscreen().catch(()=>{}); }, 500);
    renderExam();
  }
}

function startLockPolling(){
  if(STATE.lockPollTimer) clearInterval(STATE.lockPollTimer);
  STATE.lockPollTimer = setInterval(async ()=>{
    const res = await callServer('getHasilStatus', STATE.examData.id_hasil);
    if(res.status === 'dikerjakan'){
      clearInterval(STATE.lockPollTimer);
      STATE.examLocked = false;
      toast('Pengawas mengizinkan Anda melanjutkan ujian','success');
      renderExam();
      const el=document.documentElement; if(el.requestFullscreen) el.requestFullscreen().catch(()=>{});
      startExamTimer();
    } else if(res.status === 'selesai'){
      clearInterval(STATE.lockPollTimer);
      finishExamUI(null);
    }
  }, 3000);
}

function startExamTimer(){
  if(STATE.examTimer) clearInterval(STATE.examTimer);
  STATE.examTimer = setInterval(()=>{
    if(STATE.examLocked) return;
    STATE.examSecondsLeft--;
    const tmEl = document.getElementById('examTimerDisplay');
    if(tmEl) tmEl.textContent = formatTime(STATE.examSecondsLeft);
    if(STATE.examSecondsLeft <= 0){ clearInterval(STATE.examTimer); submitExam(true); }
  }, 1000);
}
function formatTime(s){ const m = Math.floor(s/60); const sec = s%60; return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`; }

function renderExam(){
  if(STATE.examLocked){
    root.innerHTML = `<div class="lock-overlay">
      <h2>🔒 Ujian Dikunci</h2>
      <p>Anda terlalu banyak melakukan percobaan keluar dari aplikasi ujian.</p>
      <p style="margin-top:10px">Mohon tunggu, pengawas akan segera memeriksa dan memutuskan.</p>
      <p style="margin-top:16px;font-size:13px;color:#fca5a5">Timer ujian telah dijeda sementara.</p>
    </div>`;
    return;
  }
  const { ujian, soalList } = STATE.examData;
  const idx = STATE.currentSoalIndex;
  const soal = soalList[idx];
  root.innerHTML = `
  <div class="exam-screen">
    <div class="exam-header">
      <div><strong>${ujian.nama_ujian}</strong><div style="font-size:11px;opacity:.8">${STATE.user.nama}</div></div>
      <div class="timer" id="examTimerDisplay">${formatTime(STATE.examSecondsLeft)}</div>
    </div>
    <div class="exam-body">
      <div class="soal-nav">
        ${soalList.map((s,i)=>`<button class="${STATE.examAnswers[s.id_soal]!==undefined?'answered':''} ${i===idx?'current':''}" data-goto="${i}">${i+1}</button>`).join('')}
      </div>
      <div class="card">
        <div style="font-size:12px;color:var(--muted);margin-bottom:8px">Soal ${idx+1} dari ${soalList.length} — ${labelTipe(soal.tipe_soal)}</div>
        <div style="font-weight:600;margin-bottom:16px">${soal.pertanyaan}</div>
        <div id="soalContent"></div>
      </div>
      <div style="display:flex;justify-content:space-between;margin-top:16px">
        <button class="btn ghost" id="btnPrevSoal" ${idx===0?'disabled style="opacity:.4"':''}>Sebelumnya</button>
        ${idx===soalList.length-1 ? '<button class="btn success" id="btnSelesai">Selesai & Kumpulkan</button>' : '<button class="btn" id="btnNextSoal">Selanjutnya</button>'}
      </div>
    </div>
  </div>`;
  renderSoalContent(soal);
  soalList.forEach((s,i)=>{ document.querySelector(`[data-goto="${i}"]`).onclick = ()=>{ STATE.currentSoalIndex = i; renderExam(); }; });
  if(idx>0) document.getElementById('btnPrevSoal').onclick = ()=>{ STATE.currentSoalIndex--; renderExam(); };
  if(idx<soalList.length-1) document.getElementById('btnNextSoal').onclick = ()=>{ STATE.currentSoalIndex++; renderExam(); };
  else document.getElementById('btnSelesai').onclick = ()=>{ if(confirm('Yakin ingin mengumpulkan jawaban? Jawaban tidak bisa diubah lagi.')) submitExam(false); };
}

function renderSoalContent(soal){
  const el = document.getElementById('soalContent');
  const current = STATE.examAnswers[soal.id_soal];
  if(soal.tipe_soal==='pg'){
    el.innerHTML = soal.data_soal.opsi.map(o=>`<div class="opsi-item ${current===o.k?'selected':''}" data-pick="${o.k}"><strong>${o.k.toUpperCase()}.</strong> ${o.v}</div>`).join('');
    el.querySelectorAll('[data-pick]').forEach(d=> d.onclick = ()=>{ STATE.examAnswers[soal.id_soal] = d.dataset.pick; renderExam(); });
  } else if(soal.tipe_soal==='pg_kompleks'){
    const sel = current || [];
    el.innerHTML = soal.data_soal.opsi.map(o=>`<div class="opsi-item ${sel.includes(o.k)?'selected':''}" data-pickm="${o.k}"><strong>${o.k.toUpperCase()}.</strong> ${o.v}</div>`).join('') + `<p style="font-size:12px;color:var(--muted);margin-top:6px">Pilih 2 jawaban yang benar</p>`;
    el.querySelectorAll('[data-pickm]').forEach(d=> d.onclick = ()=>{
      let arr = STATE.examAnswers[soal.id_soal] || [];
      const k = d.dataset.pickm;
      if(arr.includes(k)) arr = arr.filter(x=>x!==k);
      else if(arr.length<2) arr = [...arr, k];
      STATE.examAnswers[soal.id_soal] = arr; renderExam();
    });
  } else if(soal.tipe_soal==='benar_salah'){
    el.innerHTML = `
      <div class="opsi-item ${current===true?'selected':''}" data-bs="true">Benar</div>
      <div class="opsi-item ${current===false?'selected':''}" data-bs="false">Salah</div>`;
    el.querySelectorAll('[data-bs]').forEach(d=> d.onclick = ()=>{ STATE.examAnswers[soal.id_soal] = d.dataset.bs==='true'; renderExam(); });
  } else if(soal.tipe_soal==='menjodohkan'){
    const pasangan = current || {};
    const kananShuffled = soal.data_soal.kanan;
    el.innerHTML = soal.data_soal.kiri.map(k=>`
      <div class="match-row"><div style="flex:1">${k.v}</div>
      <select data-match="${k.k}" style="flex:1;padding:8px;border:1px solid var(--border);border-radius:8px">
        <option value="">-- pilih jawaban --</option>
        ${kananShuffled.map(r=>`<option value="${r.k}" ${pasangan[k.k]===r.k?'selected':''}>${r.v}</option>`).join('')}
      </select></div>`).join('');
    el.querySelectorAll('[data-match]').forEach(sel2=> sel2.onchange = ()=>{
      const p = STATE.examAnswers[soal.id_soal] || {};
      p[sel2.dataset.match] = sel2.value;
      STATE.examAnswers[soal.id_soal] = p;
    });
  }
}

async function submitExam(autoByTimer){
  clearInterval(STATE.examTimer);
  if(STATE.lockPollTimer) clearInterval(STATE.lockPollTimer);
  const res = await callServer('submitJawaban', STATE.examData.id_hasil, STATE.examAnswers, false);
  finishExamUI(res.nilai);
}
function finishExamUI(nilai){
  stopExamMonitoring();
  if(document.fullscreenElement) document.exitFullscreen().catch(()=>{});
  root.innerHTML = `
  <div class="login-wrap"><div class="login-card" style="text-align:center">
    <h1 style="color:var(--success)">✓ Ujian Selesai</h1>
    <p class="sub">Terima kasih, jawaban Anda telah dikumpulkan.</p>
    ${nilai!==null ? `<div style="font-size:13px;color:var(--muted);margin-top:10px">Nilai akan diumumkan oleh guru.</div>` : ''}
    <button class="btn" style="width:100%;margin-top:20px" id="btnKembali">Kembali ke Halaman Masuk</button>
  </div></div>`;
  document.getElementById('btnKembali').onclick = logout;
}

// ====================== START APP ======================
render();
</script>
</body>
</html>
