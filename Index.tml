    </div>`;
  } else if(STATE.view==='soal'){ html = await renderBankSoal(); }
  else if(STATE.view==='ujian'){ html = await renderBuatUjian(); }
  else if(STATE.view==='token'){ html = await renderTokenPeserta(); }
  else if(STATE.view==='monitoring'){ html = await renderMonitoring(); }
